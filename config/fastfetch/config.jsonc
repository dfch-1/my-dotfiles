{
//"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
  "source": "",
  "type": "auto",
  "height": 15,
  "width": 15,
  "padding": {
    "top": 1
    }
  },
"display": {
  "separator": " ::  ",
  "size":{
    "binaryPrefix":"si"
  }
},

"modules": [
  "break",
  {
    "type": "custom",
    "format": "╭──────────────────────── {#italic_red}Software{#} ───────────────────────╮"
  },
  {
    "type": "os",
    "key": " 󰣇 OS      ",
    "keyColor": "31"
  },
  {
    "type": "kernel",
    "key": "  Kernel  ",
    "keyColor": "31"
  },
  {
    "type": "packages",
    "key": " 󰏖 Packages",
    "keyColor": "31"
  },
  {
    "type": "wm",
    "key": "  WM      ",
    "keyColor": "31"
  },
  {
    "type": "shell",
    "key": "  Shell   ",
    "keyColor": "31"
  },
  {
    "type": "terminal",
    "key": "  Terminal",
    "keyColor": "31"
  },
  {
    "type": "terminalfont",
    "key": "  Font    ",
    "keyColor": "31"
  },
  {
    "type": "custom",
    "format": "╰──────────────────────────────────────────────────────────╯"
  },
  "break",
    {
      "type": "custom",
      "format": "╭──────────────────────── {#italic_red}Hardware{#} ────────────────────────╮"
  },
  {
    "type": "host",
    "format": "{2}",
    "key": " 󰌢 Host    ",
    "keyColor": "31"
  },
  {
    "type": "cpu",
    "key": "  CPU     ",
    "keyColor": "31"
  },
  {
    "type": "gpu",
    "key": " 󰢮 GPU     ",
    "keyColor": "31"
  },
  {
    "type": "memory",
    "key": "  Memory  ",
    "keyColor": "31"
  },
  {
    "type": "disk",
    "key": " 󰋊 Disk    ",
    "keyColor": "31"
  },
  {
    "type": "display",
    "key": "  Display ",
    "keyColor": "31"
  },
  {
    "type": "custom",
    "format": "╰──────────────────────────────────────────────────────────╯"
  },
  "break"
]
}