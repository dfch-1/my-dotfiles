{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
  "source": "",
  "type": "auto",
  "height": 15,
  "width": 30,
  "padding": {
    "top": 1
    }
  },
"display": {
  "separator": " ➜  ",
  "size":{
    "binaryPrefix":"si"
  }
},

"modules": [
  "break",
  {
    "type": "title",
    "keyColor": "red"
  },
  {
    "type": "custom",
    "format": "\u001b[90m┌─────────────────────────Software─────────────────────────┐"
  },
  {
    "type": "os",
    "key": "├  ",
    "keyColor": "31"
  },
  {
    "type": "kernel",
    "key": "├  ",
    "keyColor": "31"
  },
  {
    "type": "uptime",
    "key": "├  ",
    "keyColor": "31"
  },
  {
    "type": "packages",
    "key": "├ 󰏖 ",
    "keyColor": "31"
  },
  {
    "type": "shell",
    "key": "├  ",
    "keyColor": "31"
  },
  {
    "type": "custom",
    "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
  },
  "break",
  {
    "type": "custom",
    "format": "\u001b[90m┌──────────────────────────DE/WM───────────────────────────┐"
  },
  {
    "type": "wm",
    "key": "├  ",
    "keyColor": "32"
  },
  {
    "type": "wmtheme",
    "key": "├ 󰉼 ",
    "keyColor": "32"
  },
  {
    "type": "icons",
    "key": "├ 󰀻 ",
    "keyColor": "32"
  },
  {
    "type": "cursor",
    "key": "├ 󰇀 ",
    "keyColor": "32"
  },
  {
    "type": "terminal",
    "key": "├  ",
    "keyColor": "32"
  },
  {
    "type": "terminalfont",
    "key": "├  ",
    "keyColor": "32"
  },
  {
    "type": "custom",
    "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
  },
  "break",
  {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────────Hardware─────────────────────────┐"
  },
  {
    "type": "host",
    "format": "{2}",
    "key": "├ 󰌢 ",
    "keyColor": "33"
  },
  {
    "type": "cpu",
    "key": "├  ",
    "keyColor": "33"
  },
  {
    "type": "gpu",
    "key": "├ 󰢮 ",
    "keyColor": "33"
  },
  {
    "type": "memory",
    "key": "├  ",
    "keyColor": "33"
  },
  {
    "type": "swap",
    "key": "├ 󰓡 ",
    "keyColor": "33"
  },
  {
    "type": "disk",
    "key": "├ 󰋊 ",
    "keyColor": "33"
  },
  {
    "type": "battery",
    "key": "├  ",
    "keyColor": "33"
  },
  {
    "type": "display",
    "key": "├  ",
    "keyColor": "33"
  },
  {
    "type": "custom",
    "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
  },
  "break",
]
}